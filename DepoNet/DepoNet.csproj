  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DepoNet.Business\DepoNet.Business.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Views\" />
  </ItemGroup>

